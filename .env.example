# Senha para acessar o app
AUTH_PASSWORD=change-me

# Senha para editar/excluir agentes
AUTH_EDIT_PASSWORD=change-me-too

# Chave secreta para cookies de sessão (use uma string longa e aleatória)
AUTH_SECRET=change-this-to-a-random-secret

# Railway: monte um volume em /data e defina esta variável
# PERSISTENT_DATA_PATH=/data
